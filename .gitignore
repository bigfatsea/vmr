# Ver 2026-07-31 17:00, by Sonnet 5

# Binaries
/vmr
/bin/
*.exe
skills-lock.json
*.local.yaml

# Local config with real keys (use config.example.yaml as template)
/config.yaml

# vmr report/vmr story sidecar config — may hold a plaintext llm_key
# (use report.example.yaml as template)
/report.yaml

# Your own pricing supplement, referenced from config.yaml's pricing.supplement
# (use pricing.example.yaml as template)
/pricing.yaml

# Test & coverage
*.test
*.out
coverage.html

# Scratch
/_tmp/

# OS / editor
.DS_Store
.idea/
.vscode/
.claude
.agents

# Generated reports (details/ carries full conversation bodies — never commit)
/vmr-report.json
/vmr-report.md
/vmr-requests.md
/vmr-requests-*.md
/details/
/archived/

# Audit data (may contain full conversation bodies — never commit)
*.jsonl
*.jsonl.zst
!/examples/*.jsonl

# Runtime logs (vmr.sh daemon + audit) and image-downscale cache — only
# populated here as internal/rundir's last-resort fallback, reached when
# neither the home directory nor the system temp dir can be resolved; the
# normal default is the persistent ~/.vmr/logs and ~/.vmr/image_cache
# (config.yaml's log_dir/image_cache_dir, unset). /logs/ also covers
# logs/loadtest/ (loadtest/config.yaml's log_dir) — no separate rule needed.
/logs/
/image_cache/
/reports/

# loadtest (loadtest/README.md): generated output lands in the /logs/ and
# /reports/ rules above (namespaced: logs/loadtest/, reports/loadtest-*).
# targets*.json (the combined file plus its plain/image cost-regime subsets,
# see loadtest/gentargets) is regenerated every run and deleted when the run
# finishes — this only catches it if a run gets interrupted mid-way.
/loadtest/targets*.json
