# Ver 2026-09-23 01:50, by GLM-4.7

# Binaries
/vmr
/bin/
*.exe
skills-lock.json
*.local.yaml
*.bak

# Local config with real keys (use config.example.yaml as template). The
# wildcard also catches hand-made copies ("config copy.yaml",
# "config.mba-2025.yaml", …) that a careless `git add -A` would otherwise
# sweep in; the tracked example/minimal templates are re-admitted below.
/config*.yaml
!/config.example.yaml
!/config.example.zh.yaml
!/config.minimal.yaml
!/config.minimal.zh.yaml

# vmr analyze sidecar config — may hold a plaintext llm_key
# (use report.example.yaml as template)
/report.yaml

# Personal pricing scratchpad (the supplement-file mechanism is no longer
# supported — the runtime never loads this; keeping the path gitignored so
# any future ad-hoc work the user takes on stays out of the repo)
/pricing.yaml

# Test & coverage
*.test
*.out
coverage.html

# Scratch
_tmp
_review
_subtasks
/scratch_vmr

# OS / editor
.DS_Store
.idea/
.vscode/
.claude
.agents
.pi

# Router-generated quota accounting state, when log_dir resolves to the
# repo root (e.g. a smoke-test run) — the normal default is
# ~/.vmr/logs/vmr-quota.json, already covered by /logs/ below
/vmr-quota.json

# Generated reports at the repo root (a stray `vmr analyze -o .`; the
# normal output dir is ./reports/, covered below). These carry full
# conversation bodies — never commit.
/vmr-report.md
/manifest.json
/macro/
/requests/
/journeys/
/compares/
/archived/
/sample_reports/

# Audit data (may contain full conversation bodies — never commit)
*.jsonl
*.jsonl.zst
!/examples/*.jsonl

# Runtime logs (vmr.sh daemon + audit) and image-downscale cache — only
# populated here as internal/rundir's last-resort fallback, reached when
# neither the home directory nor the system temp dir can be resolved; the
# normal default is the persistent ~/.vmr/logs and ~/.vmr/image_cache
# (config.yaml's log_dir/image_cache_dir, unset). /logs/ also covers
# logs/loadtest/ (loadtest/config.yaml's log_dir) — no separate rule needed.
/logs/
/image_cache/
/reports/
/reports-en/

# loadtest (loadtest/README.md): generated output lands in the /logs/ and
# /reports/ rules above (namespaced: logs/loadtest/, reports/loadtest-*).
# targets*.json (the combined file plus its plain/image cost-regime subsets,
# see loadtest/gentargets) is regenerated every run and deleted when the run
# finishes — this only catches it if a run gets interrupted mid-way.
/loadtest/targets*.json

# alma agent tooling scratch state
.alma-snapshots

# Agent Forge 运行时产物（spawn.sh 自动追加）
.forge/

# Agent Forge 资产定位（个人本机路径，不入库；协作者自建）
.agent-forge.yml

# tools/guard_corpus_scan -deep output: keeps masked previews of every
# candidate credential (prefix/suffix + hit paths + provider + timestamps)
# for human calibration review. Unlike the committed internal/guard/testdata/
# corpus_scan.json (pure aggregate counts, no preview material), these are
# not safe to commit until every entry is confirmed to be a known fixture.
/docs/design/agent-guard-corpus-deep-analysis.json
/docs/design/agent-guard-corpus-deep-analysis-report.md
